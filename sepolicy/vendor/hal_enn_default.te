type hal_enn_default, domain, enn_hal_type;
type hal_enn_default_exec, exec_type, vendor_file_type, file_type;

hal_attribute(enn)
hal_attribute_service(hal_enn, hal_enn_service)
hal_client_domain(untrusted_app, hal_enn)
hal_server_domain(hal_enn_default, hal_enn)

init_daemon_domain(hal_enn_default)

allow hal_enn_default gpu_device:chr_file { ioctl read write getattr map open };
allow hal_enn_default gpu_device:dir { read open };
allow hal_enn_default npu_device:chr_file { write map };

binder_call(untrusted_app, hal_enn_default)
binder_call(hal_enn_default, untrusted_app)
